PORT=3000
# Conexión local a Supabase. En Cloudflare se usa el binding HYPERDRIVE.
DATABASE_URL=postgresql://app_backend.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require
# Direct connection con rol admin, solo para migraciones; nunca usa app_backend.
SUPABASE_DIRECT_URL=postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres
# Hyperdrive de cada entorno usa su Direct connection con credenciales de app_backend.
# Para migraciones locales, puedes reemplazar DATABASE_URL por direct connection si tu red lo soporta:
# postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres
JWT_SECRET=change-me-to-a-random-secret
AUTH_DEVICE_TRUST_ENABLED=false
FRONTEND_URL=http://localhost:5173
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-secret-key
SUPABASE_ANON_KEY=replace-with-public-anon-key
DEEPSEEK_API_KEY=replace-with-deepseek-api-key
DEEPSEEK_MODEL=deepseek-v4-flash
# Inicialización de administrador: opt-in y SOLO Supabase/PostgreSQL locales.
SEED_BOOTSTRAP_ADMIN=false
SEED_ADMIN_EMAIL=replace-with-admin-email
SEED_ADMIN_PASSWORD=replace-with-local-admin-password
SEED_ADMIN_NAME=replace-with-admin-name
SEED_SCHOOL_NAME=replace-with-local-school-name
SEED_SCHOOL_SLUG=replace-with-local-school-slug
# Importadores: rutas explícitas; alternativamente --csv <ruta>.
SCHOOLS_CSV_PATH=
SCHOOL_DEFAULTS_CSV_PATH=

# Respaldo para nuevos años escolares; no altera las fechas existentes de cada centro.
SCHOOL_YEAR_START_MONTH_DAY=08-01
SCHOOL_YEAR_END_MONTH_DAY=06-30
# Avisos del panel, no reglas oficiales de promoción.
DASHBOARD_ATTENDANCE_MINIMUM=80
DASHBOARD_GRADE_MINIMUM=70
DASHBOARD_OBSERVATION_MINIMUM=2
DASHBOARD_ATTENTION_LOOKBACK_DAYS=30
DASHBOARD_ATTENTION_PAGE_SIZE=500
DASHBOARD_ATTENTION_DISPLAY_LIMIT=4

# Suscripciones: apagadas por defecto. Solo sandbox; nunca claves live.
BILLING_ENABLED=false
BILLING_CHECKOUT_ENABLED=false
BILLING_EVENTS_ENABLED=false
BILLING_ENFORCE_ACCESS=false
BILLING_ENVIRONMENT=sandbox
# Compatibilidad histórica; las nuevas pruebas se confirman con el mes del precio Paddle.
BILLING_TRIAL_DAYS=0
BILLING_GRACE_DAYS=7
BILLING_TERMS_VERSION=
BILLING_BANK_INSTRUCTIONS=
BILLING_BANK_ACCOUNT_ID=
BILLING_SUPPORT_EMAIL=
PADDLE_SANDBOX_API_KEY=
PADDLE_SANDBOX_WEBHOOK_SECRET=
PADDLE_SANDBOX_CLIENT_TOKEN=
# Identificador AppUser de un operador con permiso comercial explícito, solo para mantenimiento sandbox.
BILLING_MAINTENANCE_ACTOR_ID=
