# Copiar a .env.billing-sandbox.local (ignorado por Git).
# Solo datos de Paddle SANDBOX. No reutilizar variables ni bases de producción.
BILLING_ENVIRONMENT=sandbox
BILLING_ENABLED=false
BILLING_CHECKOUT_ENABLED=false
BILLING_EVENTS_ENABLED=false
BILLING_ENFORCE_ACCESS=false
BILLING_TERMS_VERSION=
PADDLE_SANDBOX_API_KEY=
PADDLE_SANDBOX_CLIENT_TOKEN=
PADDLE_SANDBOX_WEBHOOK_SECRET=
# Origen de la aplicación de pruebas, sin ruta ni parámetros.
FRONTEND_URL=
