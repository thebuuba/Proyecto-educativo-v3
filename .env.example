# Copia las variables necesarias al archivo real de cada app.
# La API usa /api/v1 en el mismo origen; Vite usa el proxy solo en desarrollo.
VITE_API_PROXY_TARGET=http://localhost:3000
VITE_SUPABASE_URL=https://PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=replace-me
PORT=3000
DATABASE_URL=postgresql://app_backend.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require
JWT_SECRET=change-me
FRONTEND_URL=http://localhost:5173

SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-me
SUPABASE_ANON_KEY=replace-me
DEEPSEEK_API_KEY=replace-me
DEEPSEEK_MODEL=deepseek-v4-flash
# Inicialización de administrador: opt-in y SOLO Supabase/PostgreSQL locales.
SEED_BOOTSTRAP_ADMIN=false
SEED_ADMIN_EMAIL=replace-with-admin-email
SEED_ADMIN_PASSWORD=replace-with-local-admin-password
SEED_ADMIN_NAME=replace-with-admin-name
SEED_SCHOOL_NAME=replace-with-local-school-name
SEED_SCHOOL_SLUG=replace-with-local-school-slug
# Importadores: rutas explícitas; alternativamente --csv <ruta>.
SCHOOLS_CSV_PATH=
SCHOOL_DEFAULTS_CSV_PATH=

# Respaldo para nuevos años escolares; no altera las fechas existentes de cada centro.
SCHOOL_YEAR_START_MONTH_DAY=08-01
SCHOOL_YEAR_END_MONTH_DAY=06-30
# Avisos del panel, no reglas oficiales de promoción.
DASHBOARD_ATTENDANCE_MINIMUM=80
DASHBOARD_GRADE_MINIMUM=70
DASHBOARD_OBSERVATION_MINIMUM=2
DASHBOARD_ATTENTION_LOOKBACK_DAYS=30
DASHBOARD_ATTENTION_PAGE_SIZE=500
DASHBOARD_ATTENTION_DISPLAY_LIMIT=4

# Solo desarrollo local: las simulaciones de pago nunca se habilitan en builds de producción.
VITE_BILLING_PREVIEW_ENABLED=false
