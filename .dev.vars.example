DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54332/postgres
FRONTEND_URL=http://localhost:8787
JWT_SECRET=replace-with-a-random-development-secret
SUPABASE_ANON_KEY=replace-with-local-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key
SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=replace-with-local-anon-key
VITE_SUPABASE_URL=http://127.0.0.1:54321
DEEPSEEK_API_KEY=replace-with-development-deepseek-key
DEEPSEEK_MODEL=deepseek-v4-flash

# Respaldo para nuevos años escolares; no altera las fechas existentes de cada centro.
SCHOOL_YEAR_START_MONTH_DAY=08-01
SCHOOL_YEAR_END_MONTH_DAY=06-30
# Avisos del panel, no reglas oficiales de promoción.
DASHBOARD_ATTENDANCE_MINIMUM=80
DASHBOARD_GRADE_MINIMUM=70
DASHBOARD_OBSERVATION_MINIMUM=2
DASHBOARD_ATTENTION_LOOKBACK_DAYS=30
DASHBOARD_ATTENTION_PAGE_SIZE=500
DASHBOARD_ATTENTION_DISPLAY_LIMIT=4
