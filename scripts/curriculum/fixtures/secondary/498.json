{"sourceSha256":"80b22b3adb3290bd251bde65c98b78b60f24845ab43b70c1f4e3294e0b6f6c58","pdfPage":498,"items":[{"text":"Adecuación Curricular- Nivel Secundario","x":383.04,"y":756.75,"width":176.67979999999994,"height":11},{"text":"497","x":547.9277,"y":21.27,"width":16.929000000000002,"height":11},{"text":"Salida Optativa Ciencias y Tecnología","x":45,"y":737.25,"width":207.30840000000003,"height":13},{"text":"La Salida Optativa en Ciencias y Tecnología está orientada al desarrollo de las Competencias Fundamentales, a partir","x":45,"y":710.85,"width":521.9445000000004,"height":11},{"text":"de las Competencias Específicas en el área de Ciencias de la Naturaleza; focalizada en las aplicaciones de Biología,","x":45,"y":697.65,"width":522.0688,"height":11},{"text":"Química y Física con problemas transversales de Tecnología, Medioambiente y Salud, promoviendo el aporte de","x":45,"y":684.4499999999999,"width":522.0358000000003,"height":11},{"text":"las Ciencias y la gestión de pensamientos creativos e independientes hacia una finalidad práctica, y apoyados en el","x":45,"y":671.2499999999999,"width":522.0259000000005,"height":11},{"text":"quehacer científico y tecnológico con proyectos, prácticas, trabajo colaborativo e investigaciones; al mismo tiempo,","x":45,"y":658.0499999999998,"width":522.0490000000005,"height":11},{"text":"también procura apoyar a los estudiantes en la búsqueda de su vocación y potenciar sus talentos y aspiraciones.","x":45,"y":644.8499999999998,"width":522.0379999999999,"height":11},{"text":"En esta Salida optativa se cubren problemáticas de: salud, medioambiente, biotecnología, biología computacional,","x":45,"y":631.6499999999997,"width":522.0149000000001,"height":11},{"text":"aplicaciones químicas como fármacos, alimentos y textiles, química computacional; electrónica, robótica y física","x":45,"y":618.4499999999997,"width":522.0027999999999,"height":11},{"text":"computacional que permiten partir de un problema o situación, y desarrollar proyectos e investigaciones con el fin","x":45,"y":605.2499999999997,"width":521.9829999999998,"height":11},{"text":"del desarrollo de las competencias.","x":45,"y":592.0499999999996,"width":160.91680000000002,"height":11},{"text":"Área de Ciencias de la","x":49.75,"y":511.905,"width":78.21000000000001,"height":9},{"text":"Naturaleza","x":49.75,"y":500.907,"width":38.115,"height":9},{"text":"Horas","x":148.093,"y":517.0889999999999,"width":23.346000000000025,"height":9},{"text":"Asignaturas","x":207.13300000000004,"y":517.0889999999999,"width":47.99610000000001,"height":9},{"text":"Asignaturas","x":325.13199999999995,"y":517.0889999999999,"width":47.99700000000001,"height":9},{"text":"Asignaturas","x":446.10999999999996,"y":517.0889999999999,"width":47.99700000000001,"height":9},{"text":"4 hs.","x":148.09299999999996,"y":495.72299999999996,"width":16.011000000000013,"height":9},{"text":"Biología y Computación","x":207.13299999999998,"y":495.72299999999996,"width":85.9581,"height":9},{"text":"Química y Computación","x":325.13200000000006,"y":495.72299999999996,"width":87.30810000000004,"height":9},{"text":"Física y Computación","x":446.11,"y":495.72299999999996,"width":76.36410000000005,"height":9},{"text":"Salida Optativa","x":53.75,"y":557.6299,"width":54.788400000000024,"height":9},{"text":"Ciencias y","x":53.75,"y":546.1819,"width":34.360199999999985,"height":9},{"text":"Tecnología","x":88.53139999999998,"y":546.1819,"width":38.49119999999999,"height":9},{"text":"Grados","x":348.1624,"y":563.1749,"width":28.701,"height":9},{"text":"Cuarto","x":242.1514,"y":543.0869,"width":27.233999999999998,"height":9},{"text":"Quinto","x":372.83140000000003,"y":543.0869,"width":27.882000000000026,"height":9},{"text":"Sexto","x":505.48240000000004,"y":543.0869,"width":22.80510000000004,"height":9}],"rules":[{"axis":"h","at":531.1500244140625,"from":143.5959930419922,"to":202.63299560546875},{"axis":"v","at":202.63299560546875,"from":509.7799987792969,"to":531.1500244140625},{"axis":"h",