{"sourceSha256":"80b22b3adb3290bd251bde65c98b78b60f24845ab43b70c1f4e3294e0b6f6c58","pdfPage":126,"items":[{"text":"Adecuación Curricular- Nivel Secundario","x":383.04,"y":756.75,"width":176.67979999999994,"height":11},{"text":"125","x":547.9277,"y":21.27,"width":16.929000000000002,"height":11},{"text":"de Logro que se refieren a la producción y comprensión oral y escrita. Dichos niveles se establecieron a partir de","x":44.996699999999976,"y":738.7449999999999,"width":522.0248000000004,"height":11},{"text":"los descriptores del Marco Común Europeo de Referencia para las Lenguas (MCERL), tomando en consideración la","x":44.996699999999976,"y":725.5449999999998,"width":522.027,"height":11},{"text":"cantidad de horas semanales de docencia y las características de nuestro contexto escolar. En el caso del inglés, se","x":44.996699999999976,"y":712.3449999999998,"width":522.0061000000001,"height":11},{"text":"trabaja el Nivel A1 en el Segundo Ciclo de Primaria, el A2 en el Primer Ciclo de Secundaria y el B1 en el Segundo Ciclo","x":44.996699999999976,"y":699.1449999999998,"width":521.9060000000003,"height":11},{"text":"de Secundaria. Para el francés, se trabaja el Nivel A1 en el Primer de Ciclo de Secundaria y en el Primer Grado del","x":44.996699999999976,"y":685.9449999999997,"width":521.9500000000002,"height":11},{"text":"Segundo Ciclo (4to Grado), y parte del A2 en los últimos dos Grados del Segundo Ciclo de Secundaria.","x":44.996699999999976,"y":672.7449999999997,"width":470.2049,"height":11},{"text":"Con la finalidad de especificar los aprendizajes de los estudiantes en cada uno de los Grados, se ha utilizado un","x":44.996699999999976,"y":646.5429999999997,"width":522.0039000000004,"height":11},{"text":"esquema de ramificación mediante el cual se divide cada Nivel de Dominio en tres subniveles en el caso del inglés","x":44.996699999999976,"y":633.3429999999996,"width":522.0148999999998,"height":11},{"text":"y en cuatro para el francés. De esta forma, es posible responder a nuestras necesidades particulares, manteniendo","x":44.996699999999976,"y":620.1429999999996,"width":522.0721000000002,"height":11},{"text":"la alineación con el Marco Común Europeo. Aunque las revisiones más actualizadas del MCERL","x":44.996699999999976,"y":606.9429999999995,"width":437.56219999999973,"height":11},{"text":"13 ","x":482.5589,"y":610.613,"width":9.549500000000004,"height":6.413},{"text":"proponen como","x":492.1084,"y":606.95,"width":74.88799999999999,"height":11},{"text":"mayores novedades la descripción del nivel pre-A1 y las actividades de mediación lingüística y cultural, estos dos","x":45.00240000000002,"y":593.75,"width":521.9500000000002,"height":11},{"text":"elementos están presentes en este diseño curricular.","x":45.00240000000002,"y":580.55,"width":242.2661999999999,"height":11},{"text":"En el primer elemento, el nivel pre-A1 se considera parte del desarrollo necesario para alcanzar el nivel A1, iniciando","x":45.00240000000002,"y":554.15,"width":521.9830000000002,"height":11},{"text":"por el aprendizaje de frases sueltas y aisladas que se procuran ubicar más luego en situaciones comunicativas con","x":45.00240000000002,"y":540.9499999999999,"width":522.0237000000003,"height":11},{"text":"sentido para alcanzar el nivel A1, al tiempo que una mayor riqueza de estos campos de vocabulario también pudieran","x":45.00240000000002,"y":527.7499999999999,"width":522.0599999999998,"height":11},{"text":"apoyar o conducir a niveles más elevados de uso de la lengua. En el segundo caso, en la actividad de mediación, se","x":45.00240000000002,"y":514.5499999999998,"width":522.0929999999997,"height":11},{"text":"toma en cuenta el tratamiento de elementos culturales o del texto para comprenderlos y para presentarlos a otras","x":45.00240000000002,"y":501.34999999999985,"width":522.0665999999999,"height":11},{"text":"personas en base a la interpretación propia de los mismos para hacerlos comprensibles, transformándolos de forma","x":45.00240000000002,"y":488.14999999999986,"width":521.9807999999999,"height":11},{"text":"lógica y creativa, en traducciones, comparaciones, resúmenes, análisis, presentaciones, diálogos, dramatizaciones,","x":45.00240000000002,"y":474.9499999999999,"width":522.0479000000003,"height":11},{"text":"entre otras. Estos niveles se presentan como metas a alcanzar, implicando que se conciben como procesos en","x":45.00240000000002,"y":461.7499999999999,"width":522.0357999999999,"height":11},{"text":"desarrollo, pudiendo necesitar de más tiempo para niveles anteriores y posteriores, de acuerdo al nivel real del","x":45.00240000000002,"y":448.5499999999999,"width":522.0027999999999,"height":11},{"text":"estudiante.","x":45.00240000000002,"y":435.3499999999999,"width":51.27980000000002,"height":11},{"text":"NIVEL Y CICLO","x":95.5231,"y":407.8984,"width":62.880000000000024,"height":10},{"text":"GRADO","x":259.6631,"y":405.3984,"width":33.52999999999997,"height":10},{"text":"INGLÉS","x":390.7131,"y":405.3984,"width":32.42,"height":10},{"text":"FRANCÉS","x":497.3631,"y":407.8984,"width":41.439999999999976,"height":10},{"text":"Nivel Primario-Segundo Ciclo","x":66.01310000000001,"y":366.8884,"width":121.88900000000004,"height":10},{"text":"4to","x":269.48310000000004,"y":384.8884,"width":13.870000000000001,"height":10},{"text":"A1.1","x":397.6931000000001,"y":384.8884,"width":18.450000000000003,"height":10},{"text":"-","x":516.5431000000001,"y":387.3884,"width":3.07,"height":10},{"text":"5to","x":269.4831000000001,"y":364.3884,"width":13.870000000000001,"height":10},{"text":"A1.2","x":397.6931000000001,"y":364.3884,"width":18.450000000000003,"height":10},{"text":"-","x":516.5431000000001,"y":366.8884,"width":3.07,"height":10},{"text":"6to","x":269.4831000000001,"y":343.8884,"width":13.870000000000001,"height":10},{"text":"A1.3","x":397.6931000000001,"y":343.8884,"width":18.450000000000003,"height":10},{"text":"-","x":516.5431000000001,"y":346.3884,"width":3.07,"height":10},{"text":"Nivel Secundario-Primer Ciclo","x":65.17310000000009,"y":305.3784,"width":123.56800000000001,"height":10},{"text":"1ro","x":269.5231000000001,"y":323.3784,"width":13.789999999999978,"height":10},{"text":"A2.1","x":397.69310000000013,"y":323.3784,"width":18.450000000000003,"height":10},{"text":"A1.1","x":508.85310000000015,"y":325.8784,"width":18.450000000000003,"height":10},{"text":"2do","x":268.28310000000016,"y":302.8784,"width":16.259999999999998,"height":10},{"text":"A2.2","x":397.6931000000002,"y":302.8784,"width":18.450000000000003,"height":10},{"text":"A1.2","x":508.85310000000015,"y":305.3784,"width":18.450000000000003,"height":10},{"text":"3ro","x":269.52310000000017,"y":282.3784,"width":13.789999999999978,"height":10},{"text":"A2.3","x":397.6931000000002,"y":282.3784,"width":18.450000000000003,"height":10},{"text":"A1.3","x":508.85310000000015,"y":284.8784,"width":18.450000000000003,"height":10},{"text":"Nivel Secundario-Segundo Ciclo","x":59.99310000000014,"y":243.8684,"width":133.918,"height":10},{"text":"4to","x":269.47310000000016,"y":261.8684,"width":13.870000000000001,"height":10},{"text":"B1.1","x":398.03310000000016,"y":261.8684,"width":17.750000000000004,"height":10},{"text":"A1.4","x":508.84310000000016,"y":264.3684,"width":18.450000000000003,"height":10},{"text":"5to","x":269.47310000000016,"y":241.3684,"width":13.870000000000001,"height":10},{"text":"B1.2","x":398.03310000000016,"y":241.3684,"width":17.750000000000004,"height":10},{"text":"A2.1","x":508.84310000000016,"y":243.8684,"width":18.450000000000003,"height":10},{"text":"6to","x":269.47310000000016,"y":220.8684,"width":13.870000000000001,"height":10},{"text":"B1.3","x":398.03310000000016,"y":220.8684,"width":17.750000000000004,"height":10},{"text":"A2.2","x":508.84310000000016,"y":223.3684,"width":18.450000000000003,"height":10},{"text":"A continuación, se presenta una breve descripción de lo que debe ser capaz de realizar el estudiante para alcanzar","x":45.0002,"y":201.418,"width":522.0742999999998,"height":11},{"text":"los niveles A1, A2 y B1, de acuerdo a los niveles comunes de referencia (escala global) establecidos en el Marco","x":45.0002,"y":187.41500000000002,"width":521.9148,"height":11},{"text":"Común Europeo de Referencia para las Lenguas.","x":45.0002,"y":173.41200000000003,"width":219.37080000000003,"height":11},{"text":"Nivel A1","x":47.0022,"y":146.20900000000003,"width":40.678000000000004,"height":11},{"text":"•","x":63.9972,"y":133.00900000000004,"width":3.1020000000000003,"height":11},{"text":"Es capaz de comprender y utilizar expresiones cotidianas de uso muy frecuente, así como, frases sencillas","x":70.9932,"y":133.009,"width":496.0340000000001,"height":11},{"text":"destinadas a satisfacer necesidades de tipo inmediato.","x":70.99320000000006,"y":119.80900000000001,"width":258.94990000000007,"height":11},{"text":"13 Consejo de Europa. (2021). Marco COMÚN Europeo de Referencia para las Lenguas: aprendizaje, enseñanza, evaluación: Volumen","x":45.0002,"y":55.8001,"width":491.24430000000024,"height":9},{"text":"complementario. https://cvc.cervantes.es/ensenanza/biblioteca_ele/marco_complementario/mcer_volumen-complementario.pdf","x":45.0002,"y":45.0001,"width":486.62640000000033,"height":9}],"rules":[{"axis":"h","at":421.8999938964844,"from":45.25,"to":208.6750030517578},{"axis":"v","at":208.6750030517578,"from":401.3970031738281,"to":421.8999938964844},{"axis":"h","at":401.3970031738281,"from":45.25,"to":208.6750030517578},{"axis":"v","at":45.25,"from":401.3970031738281,"to":421.8999938964844},{"axis":"h","at":421.8999938964844,"from":208.6750030517578,"to":339.17498779296875},{"axis":"v","at":339.17498779296875,"from":401.3970031738281,"to":421.8999938964844},{"axis":"h","at":401.3970031738281,"from":208.6750030517578,"to":339.17498779296875},{"axis":"v","at":208.6750030517578,"from":401.3970031738281,"to":421.8999938964844},{"axis":"h","at":421.8999938964844,"from":339.17498779296875,"to":469.67498779296875},{"axis":"v","at":469.674987