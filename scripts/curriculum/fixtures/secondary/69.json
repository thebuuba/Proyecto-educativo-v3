":381.012,"width":66.60000000000002,"height":9},{"text":"alrededor y en el","x":474.7487,"y":370.014,"width":59.85000000000004,"height":9},{"text":"mundo.","x":474.7487,"y":359.016,"width":28.061999999999966,"height":9},{"text":"•","x":468.74569999999994,"y":347.11799999999994,"width":2.223,"height":9},{"text":"Sensibilidad y","x":474.7487,"y":347.118,"width":49.095000000000034,"height":9},{"text":"solidaridad con lo","x":474.7487,"y":336.12,"width":63.657,"height":9},{"text":"sucedido y reportado","x":474.7487,"y":325.122,"width":76.9950000000001,"height":9},{"text":"en las noticias.","x":474.74870000000004,"y":314.12399999999997,"width":51.560099999999956,"height":9},{"text":"•","x":468.74570000000006,"y":302.22599999999994,"width":2.223,"height":9},{"text":"Criticidad frente a las","x":474.7487,"y":302.226,"width":74.70899999999997,"height":9},{"text":"cuestiones relacionadas","x":474.7487,"y":291.228,"width":85.32899999999995,"height":9},{"text":"con la naturaleza y el","x":474.7487,"y":280.22999999999996,"width":74.934,"height":9},{"text":"medioambiente.","x":474.7487,"y":269.23199999999997,"width":59.3631,"height":9},{"text":"•","x":468.7457,"y":257.33399999999995,"width":2.223,"height":9},{"text":"Valoración de la","x":474.7487,"y":257.334,"width":56.556,"height":9},{"text":"escritura de la noticia","x":474.7487,"y":246.336,"width":76.05899999999998,"height":9},{"text":"como un proceso.","x":474.7487,"y":235.33800000000002,"width":64.74599999999992,"height":9},{"text":"Área de Lengua Española","x":61.7794,"y":701.55,"width":103.38209999999997,"height":9},{"text":"Nivel Secundario - Primer Ciclo","x":215.76040000000003,"y":701.55,"width":126.0162,"height":9},{"text":"1er. Grado","x":449.86840000000007,"y":701.55,"width":42.86700000000002,"height":9},{"text":"Competencias Fundamentales","x":51.64540000000005,"y":686.799,"width":123.65910000000001,"height":9},{"text":"Competencias Específicas del Grado","x":300.62140000000005,"y":686.799,"width":146.70629999999997,"height":9},{"text":"Comunicativa","x":50.00740000000005,"y":660.798,"width":55.1061,"height":9},{"text":"Se comunica con claridad en diferentes contextos, siguiendo los procesos de compresión y producción","x":185.94340000000003,"y":671.544,"width":376.54920000000004,"height":9},{"text":"oral y escrita, con creatividad, al emplear adecuadamente un tipo de texto (funcional o literario), las TIC, así","x":185.94340000000003,"y":660.5459999999999,"width":376.59870000000063,"height":9},{"text":"como otros recursos y medios.","x":185.94340000000003,"y":649.5479999999999,"width":109.71900000000001,"height":9},{"text":"Pensamiento Lógico, Creativo","x":50.00740000000005,"y":630.5489999999999,"width":118.31310000000002,"height":9},{"text":"y Crítico","x":50.00740000000005,"y":616.5449999999998,"width":32.65109999999999,"height":9},{"text":"Utiliza secuencias argumentativas (hechos, ejemplos, analogías, argumentos y contra argumentos),","x":185.94340000000003,"y":634.2929999999999,"width":376.5761999999998,"height":9},{"text":"en discursos orales y escritos, creando nuevos conocimientos a partir de procesos de comprensión y","x":185.94340000000003,"y":623.2949999999998,"width":376.60950000000037,"height":9},{"text":"producción de textos orales y escritos abordados con temas y problemas sociales de su realidad.","x":185.94340000000003,"y":612.2969999999998,"width":364.2372000000001,"height":9},{"text":"Resolución de Problemas","x":50.00740000000005,"y":591.7949999999998,"width":100.3491,"height":9},{"text":"Identifica problemas de su vida estudiantil o cotidiana a través de un tipo de texto específico y apropiado,","x":185.94340000000003,"y":597.0419999999998,"width":376.54200000000003,"height":9},{"text":"como punto de partida para su estudio y solución.","x":185.94340000000003,"y":586.0439999999998,"width":179.73000000000002,"height":9},{"text":"Ética y Ciudadana","x":50.00740000000005,"y":560.0429999999998,"width":71.00010000000002,"height":9},{"text":"Analiza textos variados de manera oral o escrita que ponen de relieve hechos y trdiciones históricas","x":185.94340000000003,"y":570.7889999999998,"width":376.5123000000003,"height":9},{"text":"relevantes, identificando nuevas relaciones sociales al reconocer y valorar el patrimonio natural y","x":185.94340000000003,"y":559.7909999999997,"width":376.54110000000037,"height":9},{"text":"sociocultural","x":185.94340000000003,"y":548.7929999999997,"width":45.738,"height":9},{"text":"dominicano.","x":240.75340000000006,"y":548.7929999999997,"width":44.75700000000003,"height":9},{"text":"Científica y Tecnológica","x":50.00740000000005,"y":528.2909999999997,"width":93.35610000000001,"height":9},{"text":"Demuestra conocimiento de procesos investigativos científicos sencillos y del uso de tecnología de","x":185.94340000000003,"y":533.5379999999997,"width":376.52130000000045,"height":9},{"text":"acuerdo con su grado, a través de textos científicos y especialmente los de secuencia expositivo-explicativa.","x":185.94340000000003,"y":522.5399999999996,"width":376.60320000000047,"height":9},{"text":"Ambiental y de la Salud","x":50.00740000000005,"y":502.0379999999996,"width":93.87000000000003,"height":9},{"text":"Explica con claridad situaciones sobre salud, medioambiente y la comunidad, mediante textos de diferente","x":185.94340000000003,"y":507.2849999999996,"width":376.5500999999998,"height":9},{"text":"secuencias y géneros, a través de herramientas tecnológicas y otros medios y recursos.","x":185.94340000000003,"y":496.28699999999964,"width":304.4601,"height":9},{"text":"Desarrollo Personal y Espiritual","x":50.00740000000005,"y":475.7849999999996,"width":125.14500000000005,"height":9},{"text":"Demuestra conocimiento y comprensión de sí mismo y de los demás al expresar su percepción del mundo,","x":185.94340000000003,"y":481.03199999999964,"width":376.5779999999999,"height":9},{"text":"a partir de un tipo de texto favorable a las situaciones y a las personas.","x":185.94340000000003,"y":470