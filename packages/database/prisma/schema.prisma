generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RecordStatus {
  ACTIVE   @map("active")
  INACTIVE @map("inactive")
  ARCHIVED @map("archived")

  @@map("record_status")
}

enum EnrollmentStatus {
  ACTIVE      @map("active")
  TRANSFERRED @map("transferred")
  WITHDRAWN   @map("withdrawn")
  COMPLETED   @map("completed")

  @@map("enrollment_status")
}

enum AttendanceStatus {
  PRESENT @map("present")
  ABSENT  @map("absent")
  LATE    @map("late")
  EXCUSED @map("excused")

  @@map("attendance_status")
}

enum GradeRecordStatus {
  DRAFT     @map("draft")
  PUBLISHED @map("published")
  VOIDED    @map("voided")

  @@map("grade_record_status")
}

enum ReportStatus {
  PENDING   @map("pending")
  GENERATED @map("generated")
  FAILED    @map("failed")
  ARCHIVED  @map("archived")

  @@map("report_status")
}

enum OnboardingTourStatus {
  NOT_STARTED @map("not_started")
  IN_PROGRESS @map("in_progress")
  COMPLETED   @map("completed")
  SKIPPED     @map("skipped")

  @@map("onboarding_tour_status")
}

model School {
  id                     String       @id @default(uuid()) @db.Uuid
  name                   String
  slug                   String       @unique
  logoUrl                String?      @map("logo_url")
  sector                 String       @default("private")
  centerCode             String?      @map("center_code")
  district               String?      @map("district")
  regionalCode           String?      @map("regional_code")
  regionalName           String?      @map("regional_name")
  districtCode           String?      @map("district_code")
  districtName           String?      @map("district_name")
  lat                    Float?       @map("lat")
  lng                    Float?       @map("lng")
  niveles                String[]     @default([])
  tandas                 String[]     @default([])
  modalidades            String[]     @default([])
  schoolShift            String       @default("extended") @map("school_shift")
  primaryModality        String       @default("general") @map("primary_modality")
  enabledSubsystems      String[]     @default(["regular"]) @map("enabled_subsystems")
  officialExportsEnabled Boolean      @default(true) @map("official_exports_enabled")
  status                 RecordStatus @default(ACTIVE)
  createdAt              DateTime     @default(now()) @map("created_at")
  updatedAt              DateTime     @updatedAt @map("updated_at")

  appUsers              AppUser[]
  schoolYears           SchoolYear[]
  academicPeriods       AcademicPeriod[]
  grades                Grade[]
  sections              Section[]
  subjects              Subject[]
  teachers              Teacher[]
  students              Student[]
  guardians             Guardian[]
  studentGuardians      StudentGuardian[]
  guardianNotifications GuardianNotification[]
  sectionSubjects       SectionSubject[]
  enrollments           Enrollment[]
  attendanceDailies     AttendanceDaily[]
  attendanceClasses     AttendanceClass[]
  gradesRecords         GradesRecord[]
  evaluationActivities  EvaluationActivity[]
  evaluationInstruments EvaluationInstrument[]
  instrumentSnapshots EvaluationInstrumentSnapshot[]
  teacherInstrumentPreferences TeacherInstrumentPreference[]
  activityEvidences     EvaluationActivityEvidence[]
  activityGroups        EvaluationActivityGroup[]
  activityGroupMembers  EvaluationActivityGroupMember[]
  courseTeams           CourseTeam[]
  courseTeamMembers     CourseTeamMember[]
  pedagogicalRecoveries PedagogicalRecovery[]
  reports               Report[]
  timeSlots             TimeSlot[]
  scheduleJourneys      ScheduleJourney[]
  scheduleEntries       ScheduleEntry[]
  planningEntries       PlanningEntry[]
  dashboardTasks        DashboardTask[]
  userRoles             UserRole[]
  drEvaluationRules     DrEvaluationRule[]
  teacherJournalEntries TeacherJournalEntry[]
  teacherJournalStudents TeacherJournalStudent[]
  subjectResources       SubjectResource[]
  onboardingTourProgress OnboardingTourProgress[]

  @@index([name])
  @@index([district])
  @@index([regionalCode])
  @@index([districtCode])
  @@map("schools")
}

model Role {
  id          String       @id @default(uuid()) @db.Uuid
  key         String       @unique
  name        String       @unique
  description String?
  status      RecordStatus @default(ACTIVE)
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@map("roles")
}

model Permission {
  id          String       @id @default(uuid()) @db.Uuid
  key         String       @unique
  name        String
  description String?
  status      RecordStatus @default(ACTIVE)
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String       @map("role_id") @db.Uuid
  permissionId String       @map("permission_id") @db.Uuid
  status       RecordStatus @default(ACTIVE)
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model AppUser {
  id           String       @id @default(uuid()) @db.Uuid
  authUserId   String       @unique @map("auth_user_id") @db.Uuid
  fullName     String       @map("full_name")
  email        String       @unique
  phone        String?
  avatarUrl    String?      @map("avatar_url")
  provider     String       @default("email")
  tokenVersion Int          @default(1) @map("token_version")
  lastLoginAt  DateTime?    @map("last_login_at")
  status       RecordStatus @default(ACTIVE)
  schoolId     String       @map("school_id") @db.Uuid
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  school                        School                 @relation(fields: [schoolId], references: [id])
  userRoles                     UserRole[]
  teacher                       Teacher?
  student                       Student?
  guardian                      Guardian?
  createdNotifications          GuardianNotification[]
  recordedAttendanceDailies     AttendanceDaily[]
  recordedAttendanceClasses     AttendanceClass[]
  recordedGradesRecords         GradesRecord[]
  createdEvaluationActivities   EvaluationActivity[]
  createdCourseTeams            CourseTeam[]
  recordedPedagogicalRecoveries PedagogicalRecovery[]
  generatedReports              Report[]
  assignedDashboardTasks        DashboardTask[]        @relation("DashboardAssignee")
  createdDashboardTasks         DashboardTask[]        @relation("DashboardCreator")
  teacherJournalEntries         TeacherJournalEntry[]
  subjectResources              SubjectResource[]
  onboardingTourProgress        OnboardingTourProgress[]
  teacherInstrumentPreferences  TeacherInstrumentPreference[]
  trustedAuthDevices            TrustedAuthDevice[]
  profileSettings               UserProfileSettings?
  billingAccount                BillingAccount?
  billingAdmin                  BillingAdmin?
  billingAdminsGranted          BillingAdmin[]        @relation("BillingAdminGrantor")
  billingAdminsRevoked          BillingAdmin[]        @relation("BillingAdminRevoker")
  billingBankAccountsCreated    BillingBankAccount[]  @relation("BillingBankAccountCreator")
  billingAuditEntries           BillingAuditLog[]     @relation("BillingAuditActor")
  billingServicePeriodsGranted  BillingServicePeriod[] @relation("BillingServicePeriodGrantor")
  billingTransfersReviewed      BillingTransferRequest[] @relation("BillingTransferReviewer")
  billingBankMovementsRecorded  BillingBankMovement[] @relation("BillingBankMovementRecorder")
  billingCourtesiesGranted      BillingCourtesy[]     @relation("BillingCourtesyGrantor")
  billingCourtesiesRevoked      BillingCourtesy[]     @relation("BillingCourtesyRevoker")
  billingSupportCases           BillingSupportCase[]  @relation("BillingSupportRequester")
  billingSupportAssigned        BillingSupportCase[]  @relation("BillingSupportAssignee")
  billingSupportMessages        BillingSupportMessage[] @relation("BillingSupportAuthor")

  @@map("app_users")
}

model UserProfileSettings {
  userId         String   @id @map("user_id") @db.Uuid
  publicName     String?  @map("public_name")
  bio            String?
  birthDate      DateTime? @map("birth_date") @db.Date
  country        String?
  city           String?
  educationLevel String? @map("education_level")
  language       String @default("es")
  timezone       String @default("UTC")
  interests      String[] @default([])
  avatarPath     String? @map("avatar_path")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  user AppUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@map("user_profile_settings")
}

model TrustedAuthDevice {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  tokenHash        String    @unique @map("token_hash")
  browserSignature String    @map("browser_signature")
  networkHash      String?   @map("network_hash")
  verifiedAt       DateTime  @default(now()) @map("verified_at")
  lastSeenAt       DateTime  @default(now()) @map("last_seen_at")
  revokedAt        DateTime? @map("revoked_at")

  user AppUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("trusted_auth_devices")
}

model OnboardingTourProgress {
  id        String               @id @default(uuid()) @db.Uuid
  userId    String               @map("user_id") @db.Uuid
  schoolId  String               @map("school_id") @db.Uuid
  tourKey   String               @map("tour_key")
  version   Int                  @default(1)
  status    OnboardingTourStatus @default(NOT_STARTED)
  lastStep  Int                  @default(0) @map("last_step")
  createdAt DateTime             @default(now()) @map("created_at")
  updatedAt DateTime             @updatedAt @map("updated_at")

  user   AppUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  school School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([userId, schoolId, tourKey])
  @@index([schoolId, userId])
  @@map("onboarding_tour_progress")
}

model UserRole {
  userId    String       @map("user_id") @db.Uuid
  roleId    String       @map("role_id") @db.Uuid
  status    RecordStatus @default(ACTIVE)
  schoolId  String       @map("school_id") @db.Uuid
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  user   AppUser @relation(fields: [userId], references: [id])
  role   Role    @relation(fields: [roleId], references: [id])
  school School  @relation(fields: [schoolId], references: [id])

  @@id([userId, roleId])
  @@map("user_roles")
}

model SchoolYear {
  id                String       @id @default(uuid()) @db.Uuid
  schoolId          String       @map("school_id") @db.Uuid
  name              String
  startDate         DateTime     @map("start_date") @db.Date
  endDate           DateTime     @map("end_date") @db.Date
  isCurrent         Boolean      @default(false) @map("is_current")
  periodScheme      String       @default("trimester") @map("period_scheme")
  periodCount       Int          @default(3) @map("period_count")
  calendarSource    String       @default("school") @map("calendar_source")
  instructionalDays Int?         @map("instructional_days")
  studentWeeks      Int?         @map("student_weeks")
  teacherWeeks      Int?         @map("teacher_weeks")
  status            RecordStatus @default(ACTIVE)
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  school               School               @relation(fields: [schoolId], references: [id])
  academicPeriods      AcademicPeriod[]
  enrollments          Enrollment[]
  sectionSubjects      SectionSubject[]
  attendanceDailies    AttendanceDaily[]
  attendanceClasses    AttendanceClass[]
  gradesRecords        GradesRecord[]
  evaluationActivities EvaluationActivity[]
  courseTeams          CourseTeam[]
  reports              Report[]
  scheduleEntries      ScheduleEntry[]
  teacherJournalEntries TeacherJournalEntry[]

  @@unique([schoolId, name])
  @@index([schoolId, isCurrent])
  @@map("school_years")
}

model AcademicPeriod {
  id           String       @id @default(uuid()) @db.Uuid
  schoolYearId String       @map("school_year_id") @db.Uuid
  schoolId     String       @map("school_id") @db.Uuid
  name         String
  sequence     Int
  startDate    DateTime     @map("start_date") @db.Date
  endDate      DateTime     @map("end_date") @db.Date
  status       RecordStatus @default(ACTIVE)
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  schoolYear           SchoolYear           @relation(fields: [schoolYearId], references: [id])
  school               School               @relation(fields: [schoolId], references: [id])
  attendanceDailies    AttendanceDaily[]
  attendanceClasses    AttendanceClass[]
  gradesRecords        GradesRecord[]
  evaluationActivities EvaluationActivity[]
  scheduleEntries      ScheduleEntry[]
  planningEntries      PlanningEntry[]
  reports              Report[]
  teacherJournalEntries TeacherJournalEntry[]

  @@unique([schoolYearId, sequence])
  @@unique([schoolYearId, name])
  @@unique([id, schoolYearId])
  @@map("academic_periods")
}

model Grade {
  id                String       @id @default(uuid()) @db.Uuid
  schoolId          String       @map("school_id") @db.Uuid
  name              String
  level             String?
  sequence          Int?
  academicLevelId   String?      @map("academic_level_id") @db.Uuid
  academicCycleId   String?      @map("academic_cycle_id") @db.Uuid
  defaultModalityId String?      @map("default_modality_id") @db.Uuid
  status            RecordStatus @default(ACTIVE)
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  school          School           @relation(fields: [schoolId], references: [id])
  academicLevel   DrAcademicLevel? @relation(fields: [academicLevelId], references: [id])
  academicCycle   DrAcademicCycle? @relation(fields: [academicCycleId], references: [id])
  defaultModality DrModality?      @relation(fields: [defaultModalityId], references: [id])
  sections        Section[]
  sectionSubjects SectionSubject[]
  enrollments     Enrollment[]

  @@unique([schoolId, name, academicLevelId, academicCycleId])
  @@index([schoolId, status])
  @@map("grades")
}

model Section {
  id        String       @id @default(uuid()) @db.Uuid
  gradeId   String       @map("grade_id") @db.Uuid
  schoolId  String       @map("school_id") @db.Uuid
  name      String
  capacity  Int?
  status    RecordStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  grade             Grade             @relation(fields: [gradeId], references: [id])
  school            School            @relation(fields: [schoolId], references: [id])
  sectionSubjects   SectionSubject[]
  enrollments       Enrollment[]
  attendanceDailies AttendanceDaily[]
  attendanceClasses AttendanceClass[]
  scheduleEntries   ScheduleEntry[]
  gradesRecords     GradesRecord[]
  courseTeams       CourseTeam[]
  teacherJournalEntries TeacherJournalEntry[]

  @@unique([gradeId, name])
  @@unique([id, gradeId])
  @@index([schoolId, status])
  @@map("sections")
}

model Subject {
  id          String       @id @default(uuid()) @db.Uuid
  code        String
  schoolId    String       @map("school_id") @db.Uuid
  name        String
  description String?
  credits     Decimal?     @db.Decimal(5, 2)
  status      RecordStatus @default(ACTIVE)
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  school          School           @relation(fields: [schoolId], references: [id])
  sectionSubjects SectionSubject[]
  curriculumMappings CurriculumSubjectMapping[]

  @@unique([schoolId, code])
  @@index([schoolId, status])
  @@map("subjects")
}

model CurriculumVersion {
  id             String    @id @default(uuid()) @db.Uuid
  code           String    @unique
  level          String
  editionYear    Int       @map("edition_year")
  status         String    @default("DRAFT")
  importMetadata Json      @default("{}") @map("import_metadata")
  validatedAt    DateTime? @map("validated_at")
  publishedAt    DateTime? @map("published_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @default(now()) @map("updated_at")

  documents CurriculumDocument[]
  scopes    CurriculumScope[]
  elements  CurriculumElement[]
  relations CurriculumElementRelation[]
  spans     CurriculumSourceSpan[]
  instrumentSnapshots EvaluationInstrumentSnapshot[]

  @@map("curriculum_versions")
}

model CurriculumDocument {
  id               String   @id @default(uuid()) @db.Uuid
  versionId        String   @map("version_id") @db.Uuid
  title            String
  originalFilename String   @map("original_filename")
  sha256           String
  pageCount        Int      @map("page_count")
  issuingBody      String   @default("MINERD") @map("issuing_body")
  createdAt        DateTime @default(now()) @map("created_at")

  version CurriculumVersion       @relation(fields: [versionId], references: [id])
  spans   CurriculumSourceSpan[]

  @@unique([versionId, sha256])
  @@unique([id, versionId])
  @@map("curriculum_documents")
}

model CurriculumScope {
  id               String   @id @default(uuid()) @db.Uuid
  versionId        String   @map("version_id") @db.Uuid
  stableKey        String   @map("stable_key")
  cycle            Int?
  grade            Int?
  areaName         String?  @map("area_name")
  areaSearch       String?  @map("area_search")
  subjectName      String?  @map("subject_name")
  subjectSearch    String?  @map("subject_search")
  modalityName     String?  @map("modality_name")
  optativeExitName String?  @map("optative_exit_name")
  assignmentSourcePdfPage Int? @map("assignment_source_pdf_page")
  createdAt        DateTime @default(now()) @map("created_at")

  version  CurriculumVersion          @relation(fields: [versionId], references: [id])
  elements CurriculumElement[]
  mappings CurriculumSubjectMapping[]
  instrumentSnapshots EvaluationInstrumentSnapshot[]
  teacherInstrumentPreferences TeacherInstrumentPreference[]

  @@unique([versionId, stableKey])
  @@unique([id, versionId])
  @@index([versionId, cycle, grade, areaSearch, subjectSearch], map: "curriculum_scopes_context_idx")
  @@index([versionId, optativeExitName, grade], map: "curriculum_scopes_optative_idx")
  @@map("curriculum_scopes")
}

model CurriculumElement {
  id             String   @id @db.Uuid
  versionId      String   @map("version_id") @db.Uuid
  scopeId        String   @map("scope_id") @db.Uuid
  stableKey      String   @map("stable_key")
  elementType    String   @map("element_type")
  originalText   String   @map("original_text")
  normalizedText String   @map("normalized_text")
  reviewStatus   String   @default("PENDING") @map("review_status")
  sourceOrder    Int      @map("source_order")
  createdAt      DateTime @default(now()) @map("created_at")

  version       CurriculumVersion           @relation(fields: [versionId], references: [id])
  scope         CurriculumScope             @relation(fields: [scopeId, versionId], references: [id, versionId])
  outgoing      CurriculumElementRelation[] @relation("CurriculumRelationFrom")
  incoming      CurriculumElementRelation[] @relation("CurriculumRelationTo")
  sourceSpans   CurriculumSourceSpan[]
  snapshotSources EvaluationSnapshotSource[]

  @@unique([versionId, stableKey])
  @@unique([id, versionId])
  @@index([scopeId, elementType, sourceOrder], map: "curriculum_elements_context_idx")
  @@map("curriculum_elements")
}

model CurriculumElementRelation {
  id            String   @id @default(uuid()) @db.Uuid
  versionId     String   @map("version_id") @db.Uuid
  fromElementId String   @map("from_element_id") @db.Uuid
  toElementId   String   @map("to_element_id") @db.Uuid
  relationType  String   @map("relation_type")
  createdAt     DateTime @default(now()) @map("created_at")

  version     CurriculumVersion @relation(fields: [versionId], references: [id])
  fromElement CurriculumElement @relation("CurriculumRelationFrom", fields: [fromElementId, versionId], references: [id, versionId])
  toElement   CurriculumElement @relation("CurriculumRelationTo", fields: [toElementId, versionId], references: [id, versionId])

  @@unique([fromElementId, toElementId, relationType])
  @@map("curriculum_element_relations")
}

model CurriculumSourceSpan {
  id           String   @id @default(uuid()) @db.Uuid
  versionId    String   @map("version_id") @db.Uuid
  elementId    String   @map("element_id") @db.Uuid
  documentId   String   @map("document_id") @db.Uuid
  pdfPage      Int      @map("pdf_page")
  printedPage  String?  @map("printed_page")
  sectionName  String?  @map("section_name")
  boundingBox  Json?    @map("bounding_box")
  createdAt    DateTime @default(now()) @map("created_at")

  version  CurriculumVersion  @relation(fields: [versionId], references: [id])
  element  CurriculumElement  @relation(fields: [elementId, versionId], references: [id, versionId])
  document CurriculumDocument @relation(fields: [documentId, versionId], references: [id, versionId])

  @@unique([elementId, documentId, pdfPage])
  @@index([documentId, pdfPage], map: "curriculum_source_spans_page_idx")
  @@map("curriculum_source_spans")
}

model CurriculumSubjectMapping {
  id            String   @id @default(uuid()) @db.Uuid
  scopeId       String   @map("scope_id") @db.Uuid
  subjectId     String   @map("subject_id") @db.Uuid
  mappingStatus String   @default("REVIEWED") @map("mapping_status")
  createdAt     DateTime @default(now()) @map("created_at")

  scope   CurriculumScope @relation(fields: [scopeId], references: [id], onDelete: Cascade)
  subject Subject         @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([scopeId, subjectId])
  @@index([subjectId], map: "curriculum_subject_mappings_subject_idx")
  @@map("curriculum_subject_mappings")
}

model EvaluationCatalogRelease {
  version   String   @id
  payload   Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@map("evaluation_catalog_releases")
}

model SectionCurriculumContext {
  sectionSubjectId String @id @map("section_subject_id") @db.Uuid
  optativeExitName String @map("optative_exit_name")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  sectionSubject SectionSubject @relation(fields: [sectionSubjectId], references: [id], onDelete: Cascade)

  @@map("section_curriculum_contexts")
}

model Teacher {
  id           String       @id @default(uuid()) @db.Uuid
  userId       String?      @unique @map("user_id") @db.Uuid
  schoolId     String       @map("school_id") @db.Uuid
  employeeCode String       @map("employee_code")
  firstName    String       @map("first_name")
  lastName     String       @map("last_name")
  documentId   String?      @map("document_id")
  birthDate    DateTime?    @map("birth_date") @db.Date
  gender       String?
  phone        String?
  email        String?
  hireDate     DateTime?    @map("hire_date") @db.Date
  address      String?
  preferredLevels     String[]     @default([]) @map("preferred_levels")
  preferredShifts     String[]     @default([]) @map("preferred_shifts")
  preferredModalities String[]     @default([]) @map("preferred_modalities")
  status       RecordStatus @default(ACTIVE)
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  user            AppUser?         @relation(fields: [userId], references: [id])
  school          School           @relation(fields: [schoolId], references: [id])
  sectionSubjects SectionSubject[]

  @@unique([schoolId, employeeCode])
  @@unique([schoolId, documentId])
  @@unique([schoolId, email])
  @@index([schoolId, status])
  @@map("teachers")
}

model Student {
  id          String       @id @default(uuid()) @db.Uuid
  userId      String?      @unique @map("user_id") @db.Uuid
  schoolId    String       @map("school_id") @db.Uuid
  studentCode String       @map("student_code")
  firstName   String       @map("first_name")
  lastName    String       @map("last_name")
  documentId  String?      @map("document_id")
  birthDate   DateTime     @map("birth_date") @db.Date
  gender      String?
  address     String?
  status      RecordStatus @default(ACTIVE)
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  user                  AppUser?               @relation(fields: [userId], references: [id])
  school                School                 @relation(fields: [schoolId], references: [id])
  enrollments           Enrollment[]
  guardianNotifications GuardianNotification[]
  studentGuardians      StudentGuardian[]
  reports               Report[]
  teacherJournalStudents TeacherJournalStudent[]

  @@unique([schoolId, studentCode])
  @@unique([schoolId, documentId])
  @@map("students")
}

model Guardian {
  id         String       @id @default(uuid()) @db.Uuid
  userId     String?      @unique @map("user_id") @db.Uuid
  schoolId   String       @map("school_id") @db.Uuid
  fullName   String       @map("full_name")
  documentId String?      @map("document_id")
  phone      String?
  email      String?
  address    String?
