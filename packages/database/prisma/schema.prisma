  sandbox     Boolean              @default(true)
  createdAt   DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  user              AppUser                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  providerCustomers BillingProviderCustomer[]
  subscriptions     BillingSubscription[]
  payments          BillingPayment[]
  documents         BillingDocument[]
  servicePeriods    BillingServicePeriod[]
  transferRequests  BillingTransferRequest[]
  bankMovements     BillingBankMovement[]
  trial             BillingTrial?
  courtesies        BillingCourtesy[]
  supportCases      BillingSupportCase[]
  outbox            BillingOutbox[]
  auditEntries      BillingAuditLog[]

  @@index([status])
  @@map("billing_accounts")
}

model BillingProviderCustomer {
  id                 String             @id @default(uuid()) @db.Uuid
  accountId          String             @map("account_id") @db.Uuid
  provider           BillingProvider
  environment        BillingEnvironment @default(SANDBOX)
  providerCustomerId String             @map("provider_customer_id")
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  account BillingAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, provider, environment])
  @@unique([provider, environment, providerCustomerId])
  @@map("billing_provider_customers")
}

model BillingSubscription {
  id                   String                    @id @default(uuid()) @db.Uuid
  accountId            String                    @map("account_id") @db.Uuid
  planId               String                    @map("plan_id") @db.Uuid
  priceId              String                    @map("price_id") @db.Uuid
  provider             BillingProvider           @default(MANUAL)
  environment          BillingEnvironment        @default(SANDBOX)
  providerSubscriptionId String?                 @map("provider_subscription_id")
  status               BillingSubscriptionStatus @default(INCOMPLETE)
  providerStatus       String?                   @map("provider_status")
  currentPeriodStart   DateTime?                 @map("current_period_start") @db.Timestamptz(6)
  currentPeriodEnd     DateTime?                 @map("current_period_end") @db.Timestamptz(6)
  cancelAtPeriodEnd    Boolean                   @default(false) @map("cancel_at_period_end")
  startedAt            DateTime?                 @map("started_at") @db.Timestamptz(6)
  endedAt              DateTime?                 @map("ended_at") @db.Timestamptz(6)
  canceledAt           DateTime?                 @map("canceled_at") @db.Timestamptz(6)
  metadata             Json                      @default("{}")
  createdAt            DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(6)

  account    BillingAccount     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  plan       BillingPlan        @relation(fields: [planId], references: [id])
  price      BillingPrice       @relation(fields: [priceId], references: [id])
  payments   BillingPayment[]
  documents  BillingDocument[]
  trial      BillingTrial?

  @@unique([id, accountId], map: "billing_subscriptions_id_account_unique")
  @@index([accountId, status])
  @@map("billing_subscriptions")
  pricePlan BillingPrice @relation("Integritybilling_subscription_price_plan_fk", fields: [priceId, planId], references: [id, planId], onDelete: NoAction, onUpdate: NoAction, map: "billing_subscription_price_plan_fk")
  ownerPayments BillingPayment[] @relation("Integritybilling_payment_subscription_owner_fk")
  ownerDocuments BillingDocument[] @relation("Integritybilling_document_subscription_owner_fk")
}

model BillingPayment {
  id                  String               @id @default(uuid()) @db.Uuid
  accountId           String               @map("account_id") @db.Uuid
  subscriptionId      String?              @map("subscription_id") @db.Uuid
  planId              String?              @map("plan_id") @db.Uuid
  priceId             String?              @map("price_id") @db.Uuid
  source              BillingPaymentSource
  provider            BillingProvider      @default(MANUAL)
  environment         BillingEnvironment   @default(SANDBOX)
  providerPaymentId   String?              @map("provider_payment_id")
  providerInvoiceId   String?              @map("provider_invoice_id")
  amountMinor         BigInt               @map("amount_minor")
  amountRefundedMinor BigInt               @default(0) @map("amount_refunded_minor")
  currency            String               @db.Char(3)
  status              BillingPaymentStatus @default(PENDING)
  reference           String?
  idempotencyKey      String?              @map("idempotency_key")
  paidAt              DateTime?            @map("paid_at") @db.Timestamptz(6)
  failedAt            DateTime?            @map("failed_at") @db.Timestamptz(6)
  failureCode         String?              @map("failure_code")
  metadata            Json                 @default("{}")
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  account          BillingAccount          @relation(fields: [accountId], references: [id], onDelete: Cascade)
  subscription     BillingSubscription?    @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  plan             BillingPlan?            @relation(fields: [planId], references: [id])
  price            BillingPrice?           @relation(fields: [priceId], references: [id])
  documents        BillingDocument[]
  servicePeriods   BillingServicePeriod[]
  transferRequests BillingTransferRequest[]

  @@unique([id, accountId], map: "billing_payments_id_account_unique")
  @@index([accountId, status, createdAt])
  @@index([subscriptionId])
  @@map("billing_payments")
  subscriptionOwner BillingSubscription? @relation("Integritybilling_payment_subscription_owner_fk", fields: [subscriptionId, accountId], references: [id, accountId], onDelete: NoAction, onUpdate: NoAction, map: "billing_payment_subscription_owner_fk")
  pricePlan BillingPrice? @relation("Integritybilling_payment_price_plan_fk", fields: [priceId, planId], references: [id, planId], onDelete: NoAction, onUpdate: NoAction, map: "billing_payment_price_plan_fk")
  ownerServicePeriods BillingServicePeriod[] @relation("Integritybilling_period_payment_owner_fk")
  ownerTransfers BillingTransferRequest[] @relation("Integritybilling_transfer_payment_owner_fk")
  ownerDocuments BillingDocument[] @relation("Integritybilling_document_payment_owner_fk")
}

model BillingDocument {
  id                 String              @id @default(uuid()) @db.Uuid
  accountId          String              @map("account_id") @db.Uuid
  paymentId          String?             @map("payment_id") @db.Uuid
  subscriptionId     String?             @map("subscription_id") @db.Uuid
  documentType       BillingDocumentType @map("document_type")
  number             String?
  amountMinor        BigInt              @map("amount_minor")
  currency           String              @db.Char(3)
  storagePath        String?             @map("storage_path")
  providerDocumentId String?             @map("provider_document_id")
  environment        BillingEnvironment  @default(SANDBOX)
  issuedAt           DateTime?           @map("issued_at") @db.Timestamptz(6)
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)

  account      BillingAccount       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  payment      BillingPayment?      @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  subscription BillingSubscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([accountId, issuedAt])
  @@map("billing_documents")
  paymentOwner BillingPayment? @relation("Integritybilling_document_payment_owner_fk", fields: [paymentId, accountId], references: [id, accountId], onDelete: NoAction, onUpdate: NoAction, map: "billing_document_payment_owner_fk")
  subscriptionOwner BillingSubscription? @relation("Integritybilling_document_subscription_owner_fk", fields: [subscriptionId, accountId], references: [id, accountId], onDelete: NoAction, onUpdate: NoAction, map: "billing_document_subscription_owner_fk")
}

model BillingServicePeriod {
  id          String                @id @default(uuid()) @db.Uuid
  accountId   String                @map("account_id") @db.Uuid
  planId      String                @map("plan_id") @db.Uuid
  paymentId   String?               @map("payment_id") @db.Uuid
  source      BillingCoverageSource
  startsAt    DateTime              @map("starts_at") @db.Timestamptz(6)
  endsAt      DateTime              @map("ends_at") @db.Timestamptz(6)
  grantedBy   String?               @map("granted_by") @db.Uuid
  note        String?
  createdAt   DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)

  account          BillingAccount          @relation(fields: [accountId], references: [id], onDelete: Cascade)
  plan             BillingPlan             @relation(fields: [planId], references: [id])
  payment          BillingPayment?         @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  grantor          AppUser?                @relation("BillingServicePeriodGrantor", fields: [grantedBy], references: [id], onDelete: SetNull)
  transferRequests BillingTransferRequest[]
  courtesies       BillingCourtesy[]

  @@unique([id, accountId], map: "billing_service_periods_id_account_unique")
  @@index([accountId, startsAt, endsAt])
  @@map("billing_service_periods")
  paymentOwner BillingPayment? @relation("Integritybilling_period_payment_owner_fk", fields: [paymentId, accountId], references: [id, accountId], onDelete: NoAction, onUpdate: NoAction, map: "billing_period_payment_owner_fk")
  ownerTransfers BillingTransferRequest[] @relation("Integritybilling_transfer_period_owner_fk")
}

model BillingBankAccount {
  id            String   @id @default(uuid()) @db.Uuid
  label         String
  bankName      String   @map("bank_name")
  accountHolder String   @map("account_holder")
  accountNumber String   @map("account_number")
  currency      String   @db.Char(3)
  isActive      Boolean  @default(false) @map("is_active")
  createdBy     String?  @map("created_by") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  creator AppUser? @relation("BillingBankAccountCreator", fields: [createdBy], references: [id], onDelete: SetNull)

  @@unique([currency, accountNumber])
  @@index([isActive])
  @@map("billing_bank_accounts")
}

model BillingTransferRequest {
  id              String                @id @default(uuid()) @db.Uuid
  accountId       String                @map("account_id") @db.Uuid
  planId          String                @map("plan_id") @db.Uuid
  priceId         String                @map("price_id") @db.Uuid
  reference       String                @unique
  customerReference String?             @map("customer_reference")
  amountMinor     BigInt                @map("amount_minor")
  currency        String                @db.Char(3)
  status          BillingTransferStatus @default(PENDING)
  receiptPath     String?               @map("receipt_path")
  receiptMime     String?               @map("receipt_mime")
  receiptSizeBytes BigInt?              @map("receipt_size_bytes")
  reportedAt      DateTime?             @map("reported_at") @db.Timestamptz(6)
  expiresAt       DateTime?             @map("expires_at") @db.Timestamptz(6)
  reviewedBy      String?               @map("reviewed_by") @db.Uuid
  reviewedAt      DateTime?             @map("reviewed_at") @db.Timestamptz(6)
  rejectionReason String?               @map("rejection_reason")
  paymentId       String?               @map("payment_id") @db.Uuid
  servicePeriodId String?               @map("service_period_id") @db.Uuid
  createdAt       DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)

  account       BillingAccount        @relation(fields: [accountId], references: [id], onDelete: Cascade)
  plan          BillingPlan           @relation(fields: [planId], references: [id])
  price         BillingPrice          @relation(fields: [priceId], references: [id])
  reviewer      AppUser?              @relation("BillingTransferReviewer", fields: [reviewedBy], references: [id], onDelete: SetNull)
  payment       BillingPayment?       @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  servicePeriod BillingServicePeriod? @relation(fields: [servicePeriodId], references: [id], onDelete: SetNull)
  bankMovement  BillingBankMovement?

  @@unique([id, accountId], map: "billing_transfers_id_account_unique")
  @@index([accountId, status, createdAt])
  @@map("billing_transfer_requests")
  pricePlan BillingPrice @relation("Integritybilling_transfer_price_plan_fk", fields: [priceId, planId], references: [id, planId], onDelete: NoAction, onUpdate: NoAction, map: "billing_transfer_price_plan_fk")
  paymentOwner BillingPayment? @relation("Integritybilling_transfer_payment_owner_fk", fields: [paymentId, accountId], references: [id, accountId], onDelete: NoAction, onUpdate: NoAction, map: "billing_transfer_payment_owner_fk")
  servicePeriodOwner BillingServicePeriod? @relation("Integritybilling_transfer_period_owner_fk", fields: [servicePeriodId, accountId], references: [id, accountId], onDelete: NoAction, onUpdate: NoAction, map: "billing_transfer_period_owner_fk")
  ownerBankMovements BillingBankMovement[] @relation("Integritybilling_bank_movement_request_owner_fk")
}

model BillingBankMovement {
  id                String   @id @default(uuid()) @db.Uuid
  transferRequestId String   @unique @map("transfer_request_id") @db.Uuid
  accountId         String   @map("account_id") @db.Uuid
  bankReference     String   @map("bank_reference")
  amountMinor       BigInt   @map("amount_minor")
  currency          String   @db.Char(3)
  receivedAt        DateTime @map("received_at") @db.Timestamptz(6)
  recordedBy        String?  @map("recorded_by") @db.Uuid
  reason            String?
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  transferRequest BillingTransferRequest @relation(fields: [transferRequestId], references: [id], onDelete: Restrict)
  account         BillingAccount         @relation(fields: [accountId], references: [id], onDelete: Cascade)
  recorder        AppUser?               @relation("BillingBankMovementRecorder", fields: [recordedBy], references: [id], onDelete: SetNull)

  @@unique([currency, bankReference])
  @@index([receivedAt])
  @@map("billing_bank_movements")
  transferRequestOwner BillingTransferRequest @relation("Integritybilling_bank_movement_request_owner_fk", fields: [transferRequestId, accountId], references: [id, accountId], onDelete: NoAction, onUpdate: NoAction, map: "billing_bank_movement_request_owner_fk")
}

model BillingTrial {
  id          String             @id @default(uuid()) @db.Uuid
  accountId   String             @unique @map("account_id") @db.Uuid
  planId      String             @map("plan_id") @db.Uuid
  subscriptionId String?         @unique @map("subscription_id") @db.Uuid
  status      BillingTrialStatus @default(ACTIVE)
  startsAt    DateTime           @default(now()) @map("starts_at") @db.Timestamptz(6)
  endsAt      DateTime           @map("ends_at") @db.Timestamptz(6)
  endedAt     DateTime?          @map("ended_at") @db.Timestamptz(6)
  convertedAt DateTime?          @map("converted_at") @db.Timestamptz(6)
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  account BillingAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  plan    BillingPlan    @relation(fields: [planId], references: [id])

  subscription BillingSubscription? @relation(fields: [subscriptionId, accountId], references: [id, accountId], onDelete: Restrict, map: "billing_trials_subscription_owner_fk")

  @@unique([subscriptionId, accountId], map: "billing_trials_subscription_id_account_id_key")
  @@index([status, endsAt])
  @@map("billing_trials")
}

model BillingCourtesy {
  id               String                @id @default(uuid()) @db.Uuid
  accountId        String                @map("account_id") @db.Uuid
  planId           String                @map("plan_id") @db.Uuid
  status           BillingCourtesyStatus @default(ACTIVE)
  startsAt         DateTime              @map("starts_at") @db.Timestamptz(6)
  endsAt           DateTime?             @map("ends_at") @db.Timestamptz(6)
  reason           String
  grantedBy        String                @map("granted_by") @db.Uuid
  revokedAt        DateTime?             @map("revoked_at") @db.Timestamptz(6)
  revokedBy        String?               @map("revoked_by") @db.Uuid
  revocationReason String?               @map("revocation_reason")
  servicePeriodId  String?               @map("service_period_id") @db.Uuid
  createdAt        DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)

  account       BillingAccount        @relation(fields: [accountId], references: [id], onDelete: Cascade)
  plan          BillingPlan           @relation(fields: [planId], references: [id])
  grantor       AppUser               @relation("BillingCourtesyGrantor", fields: [grantedBy], references: [id], onDelete: Restrict)
  revoker       AppUser?              @relation("BillingCourtesyRevoker", fields: [revokedBy], references: [id], onDelete: SetNull)
  servicePeriod BillingServicePeriod? @relation(fields: [servicePeriodId], references: [id], onDelete: SetNull)

  @@index([accountId, status])
  @@map("billing_courtesies")
}

model BillingAdmin {
  id        String             @id @default(uuid()) @db.Uuid
  userId    String             @unique @map("user_id") @db.Uuid
  status    BillingAdminStatus @default(ACTIVE)
  grantedBy String?            @map("granted_by") @db.Uuid
  grantedAt DateTime           @default(now()) @map("granted_at") @db.Timestamptz(6)
  revokedAt DateTime?          @map("revoked_at") @db.Timestamptz(6)
  revokedBy String?            @map("revoked_by") @db.Uuid
  note      String?
  createdAt DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  user    AppUser  @relation(fields: [userId], references: [id], onDelete: Cascade)
  grantor AppUser? @relation("BillingAdminGrantor", fields: [grantedBy], references: [id], onDelete: SetNull)
  revoker AppUser? @relation("BillingAdminRevoker", fields: [revokedBy], references: [id], onDelete: SetNull)

  @@index([status])
  @@map("billing_admins")
}

model BillingEvent {
  id              String             @id @default(uuid()) @db.Uuid
  provider        BillingProvider
  environment     BillingEnvironment @default(SANDBOX)
  providerEventId String             @map("provider_event_id")
  eventType       String             @map("event_type")
  status          BillingEventStatus @default(RECEIVED)
  payload         Json
  payloadHash     String?            @map("payload_hash")
  signatureValid  Boolean?           @map("signature_valid")
  attempts        Int                @default(0)
  lastError       String?            @map("last_error")
  receivedAt      DateTime           @default(now()) @map("received_at") @db.Timestamptz(6)
  processedAt     DateTime?          @map("processed_at") @db.Timestamptz(6)
  nextRetryAt     DateTime?          @map("next_retry_at") @db.Timestamptz(6)
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([provider, environment, providerEventId])
  @@index([status, nextRetryAt])
  @@map("billing_events")
}

model BillingAuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  accountId   String?  @map("account_id") @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  actorType   String   @default("user") @map("actor_type")
  action      String
  entityType  String   @map("entity_type")
  entityId    String?  @map("entity_id") @db.Uuid
  beforeData  Json?    @map("before_data")
  afterData   Json?    @map("after_data")
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  account BillingAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  actor   AppUser?        @relation("BillingAuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([accountId, createdAt])
  @@index([entityType, entityId])
  @@map("billing_audit_log")
}

model BillingSupportCase {
  id               String                @id @default(uuid()) @db.Uuid
  number           String                @unique
  accountId        String?               @map("account_id") @db.Uuid
  userId           String                @map("user_id") @db.Uuid
  category         BillingSupportCategory
  status           BillingSupportStatus  @default(OPEN)
  subject          String
  description      String?
  paymentReference String?               @map("payment_reference")
  assignedTo       String?               @map("assigned_to") @db.Uuid
  lastMessageAt    DateTime?             @map("last_message_at") @db.Timestamptz(6)
  resolvedAt       DateTime?             @map("resolved_at") @db.Timestamptz(6)
  closedAt         DateTime?             @map("closed_at") @db.Timestamptz(6)
  createdAt        DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)

  account   BillingAccount?        @relation(fields: [accountId], references: [id], onDelete: SetNull)
  requester AppUser                @relation("BillingSupportRequester", fields: [userId], references: [id], onDelete: Cascade)
  assignee  AppUser?               @relation("BillingSupportAssignee", fields: [assignedTo], references: [id], onDelete: SetNull)
  messages  BillingSupportMessage[]
  outbox    BillingOutbox[]

  @@index([userId, status])
  @@index([status, createdAt])
  @@map("billing_support_cases")
}

model BillingSupportMessage {
  id           String   @id @default(uuid()) @db.Uuid
  caseId       String   @map("case_id") @db.Uuid
  authorUserId String?  @map("author_user_id") @db.Uuid
  authorType   String   @default("user") @map("author_type")
  body         String
  isInternal   Boolean  @default(false) @map("is_internal")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  case   BillingSupportCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  author AppUser?           @relation("BillingSupportAuthor", fields: [authorUserId], references: [id], onDelete: SetNull)

  @@index([caseId, createdAt])
  @@map("billing_support_messages")
}

model BillingOutbox {
  id          String              @id @default(uuid()) @db.Uuid
  accountId   String?             @map("account_id") @db.Uuid
  caseId      String?             @map("case_id") @db.Uuid
  channel     String              @default("email")
  recipient   String?
  template    String
  payload     Json                @default("{}")
  status      BillingOutboxStatus @default(PENDING)
  attempts    Int                 @default(0)
  lastError   String?             @map("last_error")
  dedupeKey   String?             @map("dedupe_key")
  scheduledAt DateTime            @default(now()) @map("scheduled_at") @db.Timestamptz(6)
  sentAt      DateTime?           @map("sent_at") @db.Timestamptz(6)
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  account BillingAccount?     @relation(fields: [accountId], references: [id], onDelete: SetNull)
  case    BillingSupportCase? @relation(fields: [caseId], references: [id], onDelete: SetNull)

  @@index([status, scheduledAt])
  @@map("billing_outbox")
}

// Activation is provisioned only by an authorized database operator, never by a school role.
model BillingRuntimeSettings {
  id            String   @id @default("commercial")
  enforceAccess Boolean  @default(false) @map("enforce_access")
  updatedAt     DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("billing_runtime_settings")
}
