model BillingPlan {
  id          String            @id @default(uuid()) @db.Uuid
  code        String            @unique
  name        String
  description String?
  status      BillingPlanStatus @default(DRAFT)
  features    String[]          @default([])
  trialDays   Int               @default(14) @map("trial_days")
  graceDays   Int               @default(7) @map("grace_days")
  isPublic    Boolean           @default(false) @map("is_public")
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  prices           BillingPrice[]
  subscriptions    BillingSubscription[]
  payments         BillingPayment[]
  servicePeriods   BillingServicePeriod[]
  trials           BillingTrial[]
  courtesies       BillingCourtesy[]
  transferRequests BillingTransferRequest[]

  @@index([status])
  @@map("billing_plans")
}

model BillingPrice {
  id              String             @id @default(uuid()) @db.Uuid
  planId          String             @map("plan_id") @db.Uuid
  version         Int
  currency        String             @db.Char(3)
  amountMinor     BigInt             @map("amount_minor")
  interval        BillingInterval    @default(MONTHLY)
  intervalCount   Int                @default(1) @map("interval_count")
  status          BillingPriceStatus @default(DRAFT)
  provider        BillingProvider    @default(MANUAL)
  providerPriceId String?            @map("provider_price_id")
  isPublic        Boolean            @default(false) @map("is_public")
  effectiveFrom   DateTime?          @map("effective_from") @db.Timestamptz(6)
  effectiveTo     DateTime?          @map("effective_to") @db.Timestamptz(6)
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  plan             BillingPlan             @relation(fields: [planId], references: [id], onDelete: Cascade)
  subscriptions    BillingSubscription[]
  payments         BillingPayment[]
  transferRequests BillingTransferRequest[]

  @@unique([planId, version])
  @@unique([id, planId], map: "billing_prices_id_plan_unique")
  @@index([planId, status])
  @@map("billing_prices")
  planSubscriptions BillingSubscription[] @relation("Integritybilling_subscription_price_plan_fk")
  planPayments BillingPayment[] @relation("Integritybilling_payment_price_plan_fk")
  planTransfers BillingTransferRequest[] @relation("Integritybilling_transfer_price_plan_fk")
}

model BillingAccount {
  id          String               @id @default(uuid()) @db.Uuid
  userId      String               @unique @map("user_id") @db.Uuid
  status      BillingAccountStatus @default(ACTIVE)
  countryCode String?              @map("country_code") @db.Char(2)
