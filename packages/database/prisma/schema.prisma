  FAILED             @map("failed")
  REFUNDED           @map("refunded")
  PARTIALLY_REFUNDED @map("partially_refunded")
  DISPUTED           @map("disputed")
  CANCELED           @map("canceled")

  @@map("billing_payment_status")
}

enum BillingDocumentType {
  INVOICE     @map("invoice")
  RECEIPT     @map("receipt")
  CREDIT_NOTE @map("credit_note")
  DEBIT_NOTE  @map("debit_note")

  @@map("billing_document_type")
}

enum BillingCoverageSource {
  SUBSCRIPTION   @map("subscription")
  TRANSFER       @map("transfer")
  MANUAL_PAYMENT @map("manual_payment")
  TRIAL          @map("trial")
  COURTESY       @map("courtesy")
  GRACE          @map("grace")

  @@map("billing_coverage_source")
}

enum BillingTransferStatus {
  PENDING      @map("pending")
  UNDER_REVIEW @map("under_review")
  APPROVED     @map("approved")
  REJECTED     @map("rejected")
  EXPIRED      @map("expired")
