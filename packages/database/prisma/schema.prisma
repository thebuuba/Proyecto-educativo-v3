// ---------------------------------------------------------------------------
// Billing foundation. Money is stored as integer minor units (BigInt); the
// commercial owner is AppUser.id, never School.id nor an editable email.
// Tables are backend-only (RLS + explicit app_backend grants) and are managed
// by migration 20261015141817_billing_foundation.sql. Partial unique indexes
// used for external ids, idempotency and "one active subscription per account"
// are created in SQL because Prisma cannot express them.
// ---------------------------------------------------------------------------

enum BillingEnvironment {
  SANDBOX    @map("sandbox")
  PRODUCTION @map("production")

  @@map("billing_environment")
}

enum BillingProvider {
  PADDLE @map("paddle")
  MANUAL @map("manual")

  @@map("billing_provider")
}

enum BillingPlanStatus {
  DRAFT   @map("draft")
  ACTIVE  @map("active")
  RETIRED @map("retired")

  @@map("billing_plan_status")
}

enum BillingPriceStatus {
  DRAFT   @map("draft")
  ACTIVE  @map("active")
  RETIRED @map("retired")

  @@map("billing_price_status")
}

enum BillingInterval {
  MONTHLY @map("monthly")
  ANNUAL  @map("annual")
  CUSTOM  @map("custom")

  @@map("billing_interval")
}

enum BillingAccountStatus {
  ACTIVE    @map("active")
  SUSPENDED @map("suspended")
  CLOSED    @map("closed")

  @@map("billing_account_status")
}

enum BillingSubscriptionStatus {
  INCOMPLETE @map("incomplete")
  TRIALING   @map("trialing")
  ACTIVE     @map("active")
  PAST_DUE   @map("past_due")
  PAUSED     @map("paused")
  CANCELED   @map("canceled")
  EXPIRED    @map("expired")
  UNKNOWN    @map("unknown")

  @@map("billing_subscription_status")
}

enum BillingPaymentSource {
  PROVIDER @map("provider")
  TRANSFER @map("transfer")
  MANUAL   @map("manual")

  @@map("billing_payment_source")
}

enum BillingPaymentStatus {
  PENDING            @map("pending")
