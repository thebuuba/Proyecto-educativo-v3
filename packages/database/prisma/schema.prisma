  CONVERTED @map("converted")
  CANCELED  @map("canceled")

  @@map("billing_trial_status")
}

enum BillingCourtesyStatus {
  ACTIVE  @map("active")
  EXPIRED @map("expired")
  REVOKED @map("revoked")

  @@map("billing_courtesy_status")
}

enum BillingAdminStatus {
  ACTIVE  @map("active")
  REVOKED @map("revoked")

  @@map("billing_admin_status")
}

enum BillingEventStatus {
  RECEIVED   @map("received")
  PROCESSING @map("processing")
  PROCESSED  @map("processed")
  FAILED     @map("failed")
  IGNORED    @map("ignored")

  @@map("billing_event_status")
}

enum BillingSupportCategory {
  BILLING      @map("billing")
  PAYMENT      @map("payment")
  SUBSCRIPTION @map("subscription")
  REFUND       @map("refund")
  TECHNICAL    @map("technical")
  OTHER        @map("other")

  @@map("billing_support_category")
